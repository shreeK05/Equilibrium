# ============================================================
# Equilibrium Root .gitignore
# ============================================================

# Local environment & secret files
.env
.env.*
*.env
!.env.example
!**/.env.example

# Android signing keys & properties
key.properties
**/key.properties
*.keystore
*.jks

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Build artifacts and caches
dist/
build/
*.log

# Python artifacts
__pycache__/
*.py[cod]
venv/
.venv/
