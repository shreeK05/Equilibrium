# Production Port (defaults to 3000)
PORT=3000

# Prisma Database Connection String
# PostgreSQL connection string from Render or a local PostgreSQL instance.
DATABASE_URL="postgresql://user:password@host:5432/equilibrium?schema=public"

# Secret string used to sign JWTs
JWT_SECRET="replace-me-with-a-secure-random-string"

# NODE_ENV should be 'production' in deployed environments
NODE_ENV="development"

# CORS configuration (comma separated list of domains, e.g., https://your-flutter-web-domain.com)
ALLOWED_ORIGINS="*"

# Email Configuration
RESEND_API_KEY=""
EMAIL_FROM="noreply@equilibrium.local"
APP_PUBLIC_URL="https://equilibrium-42g8.onrender.com"
