# ==============================================================================
# Equilibrium Server Environment Configuration Example
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' inside the 'server/' directory for local execution:
#    cp .env.example .env
# 2. Populate '.env' with your local environment values.
# 3. NEVER commit the real '.env' file or production credentials into version control.
# ==============================================================================

# Application Environment Mode ('development' | 'test' | 'production')
NODE_ENV="development"

# HTTP Server Port (default: 3000)
PORT=3000

# PostgreSQL Database Connection URL (Prisma ORM)
# Local Docker or local PostgreSQL instance:
DATABASE_URL="postgresql://postgres_user:placeholder_password@localhost:5432/equilibrium_db?schema=public"

# JSON Web Token Secret Key
# SECURITY REQUIREMENT: In production (NODE_ENV=production), this string MUST be at least 32 characters.
# Generate a secure key with: openssl rand -base64 32
JWT_SECRET="replace_with_a_secure_random_string_at_least_32_chars_long"

# CORS Allowed Origins
# Comma-separated list of allowed origins (e.g., "http://localhost:5000,https://my-app.example.com")
# Use "*" for unrestricted development access:
ALLOWED_ORIGINS="*"

# Public Application URL
# Used for constructing password reset deep links and public web share links
APP_PUBLIC_URL="http://localhost:3000"

# Transactional Email Configuration (Resend)
# Used for sending password reset links. Leave blank for development stubbing:
RESEND_API_KEY="re_placeholder_for_development_stubbing_only"
EMAIL_FROM="noreply@equilibrium.local"

# Test Suite Database Protection (Optional)
# Set to 'true' if running integration tests where automatic DB wipe is handled externally:
# SKIP_DB_WIPE="false"
