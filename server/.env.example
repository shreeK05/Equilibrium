# Production Port (defaults to 3000)
PORT=3000

# Prisma Database Connection String
# For SQLite (local/dev): file:./dev.db
# For PostgreSQL (production): postgresql://user:password@host:port/dbname?schema=public
DATABASE_URL="file:./dev.db"

# Secret string used to sign JWTs
JWT_SECRET="replace-me-with-a-secure-random-string"

# NODE_ENV should be 'production' in deployed environments
NODE_ENV="development"

# CORS configuration (comma separated list of domains, e.g., https://your-flutter-web-domain.com)
ALLOWED_ORIGINS="*"
